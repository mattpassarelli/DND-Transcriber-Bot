# ── Discord ────────────────────────────────────────────────────────────────────
# Your bot token from the Discord Developer Portal (https://discord.com/developers/applications)
DISCORD_TOKEN=your-bot-token-here

# Prefix for bot commands. Default is !
# COMMAND_PREFIX=!

# ── Speech-to-Text (Whisper) ───────────────────────────────────────────────────
# HuggingFace model ID for faster-whisper. The default is a fast, high-quality turbo model.
# STT_MODEL_ID=deepdml/faster-whisper-large-v3-turbo-ct2

# Device to run Whisper on. Use "cuda" for GPU (recommended) or "cpu".
# STT_DEVICE=cuda

# Compute type for Whisper inference.
# Use "int8_float16" for Blackwell GPUs (RTX 5000 series) to avoid cuBLAS issues.
# Use "float16" for other NVIDIA GPUs.
# STT_COMPUTE_TYPE=int8_float16

# Language code for transcription. "en" for English.
# See https://github.com/openai/whisper#available-models-and-languages for all codes.
# STT_LANGUAGE=en

# Beam size for Whisper decoding. Higher = more accurate but slower. 1 is fine for real-time.
# STT_BEAM_SIZE=1

# Minimum audio chunk size in bytes before Whisper is called (~0.25s at 16kHz mono).
# Raising this reduces hallucinations on short noise bursts that pass VAD.
# STT_MIN_AUDIO_BYTES=8000

# ── Summarization (Ollama) ─────────────────────────────────────────────────────
# URL of your local Ollama server.
# OLLAMA_URL=http://localhost:11434

# Model to use for session summarization. Must be pulled in Ollama first.
# Recommended: qwen3:14b (~9GB VRAM) — good instruction following for structured notes.
# Other options: llama3.1:8b (~5GB), mistral-small:22b (~14GB)
# OLLAMA_MODEL=qwen3:14b

# Seconds to wait for Ollama to respond before timing out. Long sessions may need more.
# OLLAMA_TIMEOUT=180

# ── Logging ────────────────────────────────────────────────────────────────────
# Log verbosity. Options: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# ── Advanced / Process Tuning ──────────────────────────────────────────────────
# Seconds of silence before a speaking user's buffered audio is flushed to Whisper.
# SPEECH_FLUSH_TIMEOUT_SECONDS=2.0

# Seconds of inactivity before a user's state is cleaned up entirely.
# USER_TIMEOUT_SECONDS=60
